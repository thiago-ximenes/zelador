# Um token por conta do Claude; conta nova e uma linha nova, sem rebuild.
CLAUDE_TOKEN_1=
CLAUDE_TOKEN_2=
CLAUDE_TOKEN_3=

# O que o zelador tem direito de fazer sozinho. Ele foi feito para rodar com as
# permissoes puladas -- e o unico modo em que "arruma o container que caiu" funciona sem
# alguem no teclado. Em 0, cada acao para e espera aprovacao que ninguem vai dar.
ZELADOR_SKIP_PERMISSOES=1
